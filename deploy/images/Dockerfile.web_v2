FROM docker.m.daocloud.io/library/node:22-alpine AS builder
WORKDIR /app
COPY app/v2/server/web/package.json app/v2/server/web/package-lock.json ./
RUN npm ci
COPY app/v2/server/web/ .
RUN npm run build

FROM docker.m.daocloud.io/library/nginx:1.27-alpine
COPY deploy/standalone/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget -qO- http://127.0.0.1/ || exit 1

{
  "pythonVersion": "3.11",
  "venvPath": ".",
  "venv": ".conda",
  "typeCheckingMode": "basic",
  "include": [
    "app/__init__.py",
    "app/server",
    "app/skills",
    "common",
    "conftest.py",
    "mcp_servers",
    "sagents",
    "scripts",
    "tests"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/node_modules",
    "**/dist",
    "**/build",
    ".conda",
    ".git",
    ".claude",
    "app/server/web",
    "deploy"
  ]
}

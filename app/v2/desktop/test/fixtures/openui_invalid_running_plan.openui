root = Stack([Heading("4 周跑步入门计划", 1), planTabs, progressCard, basisCard, submitBtn])
basisRow = RadioGroup("basis", "你目前的运动基础", ["久坐不动，几乎不运动", "偶尔活动，能快走 30 分钟", "能慢跑 10 分钟以上"], "久坐不动，几乎不运动", true)
noteText = Text("选择基础后点下方按钮，我会按你的水平调整每周的跑走比例和目标时长。")
basisCard = Card("选择你的运动基础", [basisRow, noteText])
w1Box = CheckboxGroup("w1done", "本周完成的训练（共 3 次）", ["第 1 次 跑走结合 20 分钟", "第 2 次 走路 25 分钟", "第 3 次 跑走结合 25 分钟"], [])
w1Cur = Slider("w1cur", "第 1 周完成度（%）", 0, 0, 100, 5)
w1Prog = Computed("第 1 周进度", "percent", [w1Cur, 100], 0, "", "%")
w1Chart = Chart("第 1 周训练量（分钟）", "bar", ["第 1 次", "第 2 次", "第 3 次"], [{"name": "目标时长", "values": [20, 25, 25]}])
w1a = Section("周一 · 跑走结合", [Text("慢跑 1 分钟 + 快走 2 分钟，循环 6 组，共约 20 分钟。配速不用管，能边跑边说话即可。")])
w1b = Section("周三 · 走路打基础", [Text("快走 25 分钟，全程保持微喘但能交谈的强度，重点是让身体适应规律运动。")])
w1c = Section("周六 · 跑走结合", [Text("慢跑 1 分钟 + 快走 2 分钟，循环 7 组，共约 25 分钟。跑后拉伸大腿和小腿各 30 秒。")])
w1 = Tab("第 1 周", [Card("本周目标：建立习惯", [Progress("整体进度", w1Prog), w1Box, w1Cur, w1Chart, Accordion([w1a, w1b, w1c])])])
w2Box = CheckboxGroup("w2done", "本周完成的训练（共 3 次）", ["第 1 次 跑走结合 28 分钟", "第 2 次 轻松跑 15 分钟", "第 3 次 跑走结合 30 分钟"], [])
w2Cur = Slider("w2cur", "第 2 周完成度（%）", 0, 0, 100, 5)
w2Prog = Computed("第 2 周进度", "percent", [w2Cur, 100], 0, "", "%")
w2Chart = Chart("第 2 周训练量（分钟）", "bar", ["第 1 次", "第 2 次", "第 3 次"], [{"name": "目标时长", "values": [28, 15, 30]}])
w2a = Section("周一 · 跑走结合", [Text("慢跑 2 分钟 + 快走 1 分钟，循环 8 组，共约 28 分钟。跑的段落稍微加长。")])
w2b = Section("周四 · 轻松跑", [Text("连续慢跑 15 分钟，速度以能完整说一句话为准，跑不动就走 1 分钟再继续。")])
w2c = Section("周六 · 跑走结合", [Text("慢跑 2 分钟 + 快走 1 分钟，循环 9 组，共约 30 分钟。结束后补水 200-300 毫升。")])
w2 = Tab("第 2 周", [Card("本周目标：延长跑的时间", [Progress("整体进度", w2Prog), w2Box, w2Cur, w2Chart, Accordion([w2a, w2b, w2c])])])
w3Box = CheckboxGroup("w3done", "本周完成的训练（共 4 次）", ["第 1 次 慢跑 20 分钟", "第 2 次 轻松跑 15 分钟", "第 3 次 慢跑 22 分钟", "第 4 次 交叉训练 30 分钟"], [])
w3Cur = Slider("w3cur", "第 3 周完成度（%）", 0, 0, 100, 5)
w3Prog = Computed("第 3 周进度", "percent", [w3Cur, 100], 0, "", "%")
w3Chart = Chart("第 3 周训练量（分钟）", "bar", ["第 1 次", "第 2 次", "第 3 次", "第 4 次"], [{"name": "目标时长", "values": [20, 15, 22, 30]}])
w3a = Section("周一 · 连续慢跑", [Text("连续慢跑 20 分钟，不追求速度。感觉喘就放慢，保持均匀呼吸节奏。")])
w3b = Section("周三 · 恢复跑", [Text("轻松跑 15 分钟，作为周中的恢复课，强度控制在很轻松的程度。")])
w3c = Section("周五 · 连续慢跑", [Text("连续慢跑 22 分钟，比周一多 2 分钟。跑前 5 分钟快走热身。")])
w3d = Section("周日 · 交叉训练", [Text("骑车、游泳或快走 30 分钟任选其一，帮助恢复同时保持心肺刺激。")])
w3 = Tab("第 3 周", [Card("本周目标：连续跑 20 分钟", [Progress("整体进度", w3Prog), w3Box, w3Cur, w3Chart, Accordion([w3a, w3b, w3c, w3d])])])
w4Box = CheckboxGroup("w4done", "本周完成的训练（共 4 次）", ["第 1 次 慢跑 25 分钟", "第 2 次 轻松跑 20 分钟", "第 3 次 节奏跑 18 分钟", "第 4 次 长跑 35 分钟"], [])
w4Cur = Slider("w4cur", "第 4 周完成度（%）", 0, 0, 100, 5)
w4Prog = Computed("第 4 周进度", "percent", [w4Cur, 100], 0, "", "%")
w4Chart = Chart("第 4 周训练量（分钟）", "bar", ["第 1 次", "第 2 次", "第 3 次", "第 4 次"], [{"name": "目标时长", "values": [25, 20, 18, 35]}])
w4a = Section("周一 · 慢跑", [Text("连续慢跑 25 分钟，巩固耐力基础，注意落地放松、步频稍快。")])
w4b = Section("周三 · 轻松跑", [Text("轻松跑 20 分钟，全程放松，作为两节强度课之间的过渡。")])
w4c = Section("周五 · 节奏跑", [Text("热身 5 分钟快走 + 18 分钟稍快跑（能说短句的强度）+ 放松走 5 分钟。")])
w4d = Section("周日 · 长跑", [Text("慢跑 35 分钟，全程最慢配速，重点是完成时间而不是速度。这是 4 周的收官课。")])
w4 = Tab("第 4 周", [Card("本周目标：完成 35 分钟长跑", [Progress("整体进度", w4Prog), w4Box, w4Cur, w4Chart, Accordion([w4a, w4b, w4c, w4d])])])
planTabs = Tabs([w1, w2, w3, w4])
doneInputs = [w1Box, w2Box, w3Box, w4Box]
doneTotal = Computed("已完成训练次数", "sum", doneInputs, 0)
doneRate = Computed("总完成率", "divide", [doneTotal, 14], 0, "", "%")
overallProg = Progress("4 周计划完成进度", doneRate, "info")
progressCard = Card("完成进度", [overallProg])
submitBtn = Button("submit", "提交运动基础，让我调整计划")

week1TrainSec = Section("训练安排", [week1Table])
week1Table = Table(["训练日", "内容", "时长", "强度"], [["第 1 次", "热身走 5 分 + 跑 1 分/走 2 分 × 6 组 + 放松走 5 分", "25 分钟", "轻松"], ["第 2 次", "热身走 5 分 + 跑 2 分/走 2 分 × 5 组 + 放松走 5 分", "25 分钟", "轻松"], ["第 3 次", "热身走 5 分 + 跑 3 分/走 2 分 × 4 组 + 放松走 5 分", "25 分钟", "中等"]])
week1LogSec = Section("完成打卡", [week1Log])

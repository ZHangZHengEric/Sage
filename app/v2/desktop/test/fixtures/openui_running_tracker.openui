root = Stack([heading, planInfo, levelCard, progressCard, weeksTabs])
heading = Heading("4 周跑步入门计划", 1)
planInfo = Text("有一点基础 · 每周 3 次 · 目标：连续慢跑 20 分钟 · 跑走结合，循序渐进")
levelCard = Card("运动基础", [level])
level = RadioGroup("fitness_level", "选择目前的运动基础", ["零基础：几乎不运动", "有一点基础：偶尔快走或运动（已选）", "较好：能慢跑 20 分钟以上"], "有一点基础：偶尔快走或运动（已选）", true)
progressCard = Card("完成进度", [totalPct, totalBar, week1Pct, week2Pct, week3Pct, week4Pct, totalDone])
totalPct = Computed("总体完成率", "ratioPercent", [totalDone, 12], 0, "", "%")
totalBar = Progress("总体完成率", totalPct, "success")
week1Pct = Computed("第 1 周完成率", "ratioPercent", [w1done, 3], 0, "", "%")
week2Pct = Computed("第 2 周完成率", "ratioPercent", [w2done, 3], 0, "", "%")
week3Pct = Computed("第 3 周完成率", "ratioPercent", [w3done, 3], 0, "", "%")
week4Pct = Computed("第 4 周完成率", "ratioPercent", [w4done, 3], 0, "", "%")
totalDone = Computed("总完成次数", "sum", [w1done, w2done, w3done, w4done], 0, "共完成 ", " / 12 次")

w2done = Computed("第 2 周完成次数", "count", [w2], 0)
w3done = Computed("第 3 周完成次数", "count", [w3], 0)
w4done = Computed("第 4 周完成次数", "count", [w4], 0)
weeksTabs = Tabs([week1Tab, week2Tab, week3Tab, week4Tab])

{
  "mcpServers": {
    "ALFWorld": {
      "command": "/absolute/path/Sage/.venv/bin/python",
      "args": [
        "-m",
        "evaluation_datasets.alfworld.mcp_server",
        "--state",
        "/absolute/path/sage/runtime/alfworld.sqlite3"
      ],
      "env": {
        "PYTHONPATH": "/absolute/path/Sage",
        "SAGE_RSI_CASE_PROTOCOL": "sage.rsi.case/v1"
      }
    }
  }
}

# Shared Sage Server and Docker Compose environment template.
# Docker Compose, from the repository root:
# cp .env.example deploy/standalone/.env
# deploy/compose_v2.sh up -d --build
# Native Server, from the repository root:
# cp .env.example app/v2/server/.env
# python -m app.v2.server
# Fill MySQL / optional Jaeger with your existing instances.
# Native process environment variables take precedence over its env file.

# Compose host settings. Relative SAGE_ROOT paths are resolved against
# deploy/standalone/docker-compose.yml, independently of the env file location.
SAGE_ROOT=../data/standalone
SAGE_SERVER_PUBLISHED_PORT=32000
SAGE_WEB_PORT=32001

# Native listener and data path; Compose overrides these inside the container.
SAGE_SERVER_HOST=127.0.0.1
SAGE_SERVER_PORT=8090
SAGE_SERVER_DATA=data/server_v2
SAGE_SERVER_LANGUAGE=zh

# Linux root supervisors must configure a non-root sandbox identity.
# The v2 Docker image provides these defaults; native non-root runs may omit them.
# SAGE_SERVER_LINUX_EXECUTION_UID=10001
# SAGE_SERVER_LINUX_EXECUTION_GID=10001

# Generate a random secret with: openssl rand -hex 32
SAGE_SERVER_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
SAGE_SERVER_JWT_EXPIRE_HOURS=72
SAGE_SERVER_ADMIN_USERNAME=admin
SAGE_SERVER_ADMIN_PASSWORD=change_this_admin_password

# MySQL is required. Use a dedicated database, separate from v1.
# For Docker on the same machine, change 127.0.0.1 to host.docker.internal
# and use MySQL's published host port; remote databases use their reachable host.
# Percent-encode special characters in username/password (e.g. @ -> %40).
SAGE_SERVER_MYSQL_URL=mysql://sage:change_this_mysql_password@127.0.0.1:3306/sage_v2

# Public origin for A2A Agent Cards; leave empty to use the incoming request.
# For a remote deployment, set the externally reachable Web origin.
# Compose example: http://localhost:32001; native Server: http://localhost:8090.
SAGE_SERVER_PUBLIC_URL=
SAGE_SERVER_LOG_LEVEL=info
SAGE_SERVER_LOG_FORMAT=json

# One worker only; concurrency is managed within the process.
SAGE_SERVER_MAX_CONCURRENT_RUNS=8
SAGE_SERVER_MAX_CONCURRENT_RUNS_PER_USER=2
SAGE_SERVER_MAX_PENDING_RUNS=1024

# Jaeger is optional. Leave empty to skip OTLP registration.
# SAGE_SERVER_JAEGER_URL=http://127.0.0.1:4317
# SAGE_SERVER_JAEGER_SERVICE_NAME=sage-server
# SAGE_SERVER_JAEGER_PUBLIC_URL=http://127.0.0.1:16686/jaeger

# Trace backend: noop / otlp / langfuse / phoenix. If omitted, JAEGER_URL keeps working.
# Empty preserves optional Jaeger detection; choose noop to disable tracing.
SAGE_SERVER_TRACE_BACKEND=
# SAGE_SERVER_TRACE_BACKEND=langfuse
# SAGE_SERVER_LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional browser-facing project URL; defaults to BASE_URL.
# SAGE_SERVER_LANGFUSE_PUBLIC_URL=https://cloud.langfuse.com/project/your-project
# LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
# LANGFUSE_SECRET_KEY=sk-lf-replace-me
# SAGE_SERVER_LANGFUSE_INGESTION_VERSION=4
# Use 3 for a compatible Langfuse v3 installation.
# SAGE_SERVER_TRACE_SERVICE_NAME=sage-server
# SAGE_SERVER_TRACE_ENVIRONMENT=production
# redacted captures bounded input/output; metadata omits content.
# SAGE_SERVER_TRACE_CONTENT_MODE=redacted
# SAGE_SERVER_TRACE_MAX_CONTENT_CHARS=16384
# SAGE_SERVER_TRACE_SAMPLE_RATE=1.0
# SAGE_SERVER_TRACE_TIMEOUT_SECONDS=3
# Phoenix (independent from Langfuse; full OTLP/HTTP traces URL):
# SAGE_SERVER_TRACE_BACKEND=phoenix
# SAGE_SERVER_PHOENIX_ENDPOINT=http://127.0.0.1:6006/v1/traces
# SAGE_SERVER_PHOENIX_PROJECT_NAME=sage
# SAGE_SERVER_PHOENIX_PUBLIC_URL=http://127.0.0.1:6006
# Optional for authenticated instances; only the variable name is saved.
# SAGE_SERVER_PHOENIX_API_KEY_ENV=PHOENIX_API_KEY
# PHOENIX_API_KEY=replace-me
# Generic OTLP collector (alternative to Langfuse / Phoenix / legacy Jaeger settings):
# SAGE_SERVER_TRACE_BACKEND=otlp
# SAGE_SERVER_TRACE_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# SAGE_SERVER_TRACE_OTLP_PROTOCOL=http
# SAGE_SERVER_TRACE_OTLP_INSECURE=false
